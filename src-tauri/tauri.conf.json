{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "MotionCue",
    "version":  "0.1.17",
    "identifier":  "com.motioncue.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:5191",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "macOSPrivateApi":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "MotionCue",
                                    "url":  "/?view=management",
                                    "width":  1120,
                                    "height":  760,
                                    "minWidth":  920,
                                    "minHeight":  620,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "center":  true,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027 blob: data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: data: blob:; media-src \u0027self\u0027 asset: data: blob:; font-src \u0027self\u0027 data:; frame-src about: data: blob:; child-src about: data: blob:; connect-src ipc: http://ipc.localhost"
                             }
            },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "motioncue"
                                                                  ]
                                                  }
                                  },
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMjgxQTk1RDkzRTkxNjYKUldSbWtUN1psUm9vSTAzSjVZeDd3TU5XNEY5elVHYlo3WGZGVHQzS3d5WUl6S1FXUFhQR3Y3dE4K",
                                    "endpoints":  [
                                                      "https://gitee.com/hongxiaojian/motion-cue/releases/download/latest/latest.json",
                                                      "https://github.com/yedsn/motion-cue/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
